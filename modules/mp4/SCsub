#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_mp4 = env_modules.Clone()

module_obj = []

sources = [
    "register_types.cpp",
    "video_stream_mp4.cpp",
    "mp4_playback.cpp",
]

if env["platform"] == "linuxbsd":
    # FFmpeg backend: compiled against vendored headers, loaded at runtime with
    # dlopen, so there is no link-time FFmpeg dependency.
    env_mp4.Prepend(CPPPATH=["#thirdparty/ffmpeg/include"])
    sources += [
        "ffmpeg_symbols.cpp",
        "playback_ffmpeg.cpp",
    ]
elif env["platform"] == "windows":
    # Media Foundation backend: decoders ship with Windows. mfplat/mfreadwrite
    # are loaded dynamically (Windows N safe); mfuuid is a static GUID library.
    sources += ["playback_mf.cpp"]
    env.Append(LIBS=["mfuuid", "uuid", "ole32"])

env_mp4.add_source_files(module_obj, sources)

env.modules_sources += module_obj
