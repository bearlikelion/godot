#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

Import("env")
Import("env_modules")

env_mp4 = env_modules.Clone()

module_obj = []

sources = [
    "register_types.cpp",
    "video_stream_mp4.cpp",
    "mp4_playback.cpp",
]

# When a static decode-only FFmpeg build is present under thirdparty/ffmpeg,
# link it directly on Linux and Windows: playback is then always available and
# needs no system libraries. Without it the old backends apply: dlopen'd system
# FFmpeg on Linux, Media Foundation on Windows.
ffmpeg_static_dirs = {
    "linuxbsd": "#thirdparty/ffmpeg/lib-linuxbsd-x86_64",
    "windows": "#thirdparty/ffmpeg/lib-windows-x86_64",
}
ffmpeg_static_dir = ffmpeg_static_dirs.get(env["platform"])
ffmpeg_static = (
    ffmpeg_static_dir is not None
    and env["arch"] == "x86_64"
    and os.path.isfile(env.Dir(ffmpeg_static_dir).abspath + "/libavcodec.a")
)

if ffmpeg_static:
    env_mp4.Prepend(CPPPATH=["#thirdparty/ffmpeg/include"])
    env_mp4.Append(CPPDEFINES=["MP4_FFMPEG_STATIC"])
    sources += [
        "ffmpeg_symbols.cpp",
        "playback_ffmpeg.cpp",
    ]
    env.Append(LIBPATH=[ffmpeg_static_dir])
    env.Append(LIBS=["avformat", "avcodec", "swscale", "swresample", "avutil"])
    if env["platform"] == "windows":
        # avutil's random number sources use bcrypt on Windows.
        env.Append(LIBS=["bcrypt"])
elif env["platform"] == "linuxbsd":
    # FFmpeg backend: compiled against vendored headers, loaded at runtime with
    # dlopen, so there is no link-time FFmpeg dependency.
    env_mp4.Prepend(CPPPATH=["#thirdparty/ffmpeg/include"])
    sources += [
        "ffmpeg_symbols.cpp",
        "playback_ffmpeg.cpp",
    ]
elif env["platform"] == "windows":
    # Media Foundation backend: decoders ship with Windows. mfplat/mfreadwrite
    # are loaded dynamically (Windows N safe); mfuuid is a static GUID library.
    sources += ["playback_mf.cpp"]
    env.Append(LIBS=["mfuuid", "uuid", "ole32"])

env_mp4.add_source_files(module_obj, sources)

env.modules_sources += module_obj
